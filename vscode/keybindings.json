[
    //
    // begin: extension_shortcuts
    //
    // paste and align
    { "key": "ctrl+v",       "command": "pasteAndIndent.action",              "when": "editorTextFocus && !editorReadonly" },
    { "key": "ctrl+v",       "command": "editor.action.clipboardPasteAction", "when": "!editorTextFocus" },
    { "key": "ctrl+shift+v", "command": "editor.action.clipboardPasteAction", "when": "editorTextFocus && !editorReadonly" },

    { "key": "cmd+s", "command": "searchEditorApplyChanges.apply", "when": "inSearchEditor" },
    { "key": "alt+t", "command": "workbench.action.search.toggleQueryDetails", "when": "inSearchEditor" },

    //
    // kdr_vscode_extensions
    //

    // jump prev next cursor locations
        // global: keyboard.ahk2 XButton1 & XButton2

        // local
        { "key": "ctrl+f8 ctrl+j", "command": "perFileHistory.cursorBack"   , "when": "editorTextFocus" },
        { "key": "ctrl+f8 ctrl+k", "command": "perFileHistory.cursorForward", "when": "editorTextFocus" },

    // jump prev next edit locations
        // global
        // { "key": "alt+j", "command": "navigateEditHistory.moveCursorToNextEdit"    , "when": "editorFocus" },
        // { "key": "alt+k", "command": "navigateEditHistory.moveCursorToPreviousEdit", "when": "editorFocus" },
            { "key": "alt+j", "command": "workbench.action.navigateBackInEditLocations"   , "when": "editorFocus" },
            { "key": "alt+k", "command": "workbench.action.navigateForwardInEditLocations", "when": "editorFocus" },
        // local
        { "key": "alt+shift+j", "command": "navigateEditHistory.moveCursorToPreviousEditInCurrentFile", "when": "editorTextFocus" },
        { "key": "alt+shift+k", "command": "navigateEditHistory.moveCursorToNextEditInCurrentFile"    , "when": "editorTextFocus" },
            { "key": "ctrl+q", "command": "-navigateEditHistory.moveCursorToPreviousEdit" },
            { "key": "ctrl+alt+j", "command": "-bookmarks.jumpToPrevious", "when": "editorTextFocus" },

    // jump prev next visited editors
    { "key": "ctrl+alt+j", "command": "workbench.action.openPreviousRecentlyUsedEditor"}, // , "when": "editorFocus" },
    { "key": "ctrl+alt+k", "command": "workbench.action.openNextRecentlyUsedEditor"    }, // , "when": "editorFocus" },


    //
    // end: extension_shortcuts
    //

    //
    // begin: /pc/ahk/keyboard.ahk2 > F13 & ...::tap_key()
    //
    { "key": "f8",   "command": "-{editor.action.marker.nextInFiles", "when": "editorFocus" },

    // multicursor on word/match under cursor
    { "key": "f8 3", "command": "editor.action.addSelectionToPreviousFindMatch" },
    { "key": "f8 8", "command": "editor.action.addSelectionToNextFindMatch" },
    { "key": "ctrl+f8 ctrl+8", "command": "editor.action.selectHighlights" }, // @todo figure out why this doesn't work anymore

    // jump and peek source control (git) | hjkl alike
    { "key": "f8 y", "when": "editorTextFocus && !textCompareEditorActive", "command": "runCommands", "args":{ "commands": [ "editor.action.dirtydiff.previous", "patch.ToggleQuickDiffWidgetFocus" ] } },
    { "key": "f8 o", "when": "editorTextFocus && !textCompareEditorActive", "command": "runCommands", "args":{ "commands": [ "editor.action.dirtydiff.next"    , "patch.ToggleQuickDiffWidgetFocus" ] } },
    // peek operations on dirty diff (peek widget)
        // @help because these donn't work I created an ahk @hack -> `/pc/ahk/file_pilot.ahk2`
        // { "key": "ctrl+g ctrl+r", "command": "git.revertChange"  }, 
        // { "key": "ctrl+g ctrl+s", "command": "git.stageChange"   },
        // { "key": "ctrl+g ctrl+b", "command": "diffEditor.revert" },
        // { "key": "f8 p", "command": "ahk.hack.stage_change"  }, 
        // { "key": "f8 [", "command": "ahk.hack.revert_change" }, 
        // { "key": "capslock", "command": "ahk.hack.close_peek" },

    // diff editor
    { "key": "f8 p", "command": "workbench.action.compareEditor.focusOtherSide" },

    // jump to open source control (git) | hjkl alike
    { "key": "f8 i", "command": "workbench.action.editor.previousChange", "when": "textCompareEditorVisible || editorTextFocus && !textCompareEditorActive && quickDiffDecorationCount != '0'" },
    { "key": "f8 u", "command": "workbench.action.editor.nextChange",     "when": "textCompareEditorVisible || editorTextFocus && !textCompareEditorActive && quickDiffDecorationCount != '0'" },
        // split editor textCompareEditorVisible
        { "key": "f8 i",   "command": "workbench.action.compareEditor.previousChange", "when": "textCompareEditorVisible" },
        { "key": "f8 i",   "command": "workbench.action.editor.previousChange",        "when": "editorTextFocus && !textCompareEditorActive && quickDiffDecorationCount != '0'" },
        { "key": "f8 u",   "command": "workbench.action.compareEditor.nextChange",     "when": "textCompareEditorVisible" },
        { "key": "f8 u",   "command": "workbench.action.editor.nextChange",            "when": "editorTextFocus && !textCompareEditorActive && quickDiffDecorationCount != '0'" },
    
    { "key": "ctrl+pageup",   "command": "workbench.action.previousEditor", "when": "editorFocus" },
    { "key": "ctrl+pagedown", "command": "workbench.action.nextEditor",     "when": "editorFocus" },

    //
    // jump to errors | hjkl alike
    //
    // { "key": "f8 ,", "command": "multiCommand.silentPrevProblem", "when": "editorFocus", },
    // { "key": "f8 m", "command": "multiCommand.silentNextProblem", "when": "editorFocus", },
        // @note in the need of af "delay", use extension.multiCommand.execute
        // @todo use kdr_vscode_extensions to solve this problem and get rid of extension.multiCommand.execute
        { "command": "runCommands", "key": "f8 ,",  "args": { "commands": [ // "when": "editorFocus", 
            "cursorLineStart",
            "editor.action.marker.prev",
            { "command": "extension.multiCommand.execute", "args": { "interval": 200,
                    "sequence": [ "closeMarkersNavigation", "editor.action.showHover", ] } },
        ]}},
        { "command": "runCommands", "key": "f8 m", "args": { "commands": [
            "cursorLineEnd",
            "editor.action.marker.next",
            // "closeMarkersNavigation",
            // "multiCommand.silentNextProblem"
            { "command": "extension.multiCommand.execute", "args": { "interval": 200,
                    "sequence": [ "closeMarkersNavigation", "editor.action.showHover", ] } },
            // "workbench.action.focusActiveEditorGroup",
            // // { "command": "vim.remap", "args": { "after": ["<Esc>", "W"] } }, 
            // "editor.action.hideHover",
            // // "closeMarkersNavigation",
            // // "editor.action.marker.next",
            // // "editor.foldAllMarkerRegions",
            // // "closeMarkersNavigation",
            // // "extension.vim_escape",
            // "editor.action.showHover",
            // // "workbench.action.focusSideBar",
            // // "workbench.action.focusActiveEditorGroup",
            // // "editor.action.showDefinitionPreviewHover",
            // // "editor.action.peekDefinition",
        ]}},
            { "key": "alt+f8",       "command": "-editor.action.marker.next", "when": "editorFocus" },
            { "key": "shift+alt+f8", "command": "-editor.action.marker.prev", "when": "editorFocus" },

    //
    // focus panels
    //

    // focus active editor
    { "key": "f8 0",   "command": "workbench.action.focusActiveEditorGroup" },
    { "key": "ctrl+0", "command": "workbench.action.focusActiveEditorGroup" },
        { "key": "ctrl+0", "command": "-workbench.action.focusSideBar" },

    // chat
    { "key": "f8 /", "command": "workbench.panel.chat", "when": "workbench.panel.chat.view.copilot.active" },
        { "key": "ctrl+alt+i", "command": "-workbench.panel.chat", "when": "workbench.panel.chat.view.copilot.active" },

    // focus terminal
    { "key": "f8 ;", "command": "terminal.focus" },

    // focus debugger output
    { "key": "f8 '", "command": "workbench.debug.action.focusRepl" },

        // focus toggle debug console
        // { "key": "f8 ;", "command": "workbench.action.terminal.toggleTerminal", "when": "terminal.active" },
        // { "key": "f8 '", "command": "workbench.debug.action.toggleRepl", "when": "workbench.panel.repl.view.active" },
            { "key": "ctrl+shift+y", "command": "-workbench.debug.action.toggleRepl", "when": "workbench.panel.repl.view.active" },

    // end: /pc/ahk/keyboard.ahk2 > F13 & ...::tap_key()
        
    // clear terminal and debug console
    { "key": "alt+;", "command":  "workbench.action.terminal.clear" },
    { "key": "alt+'", "command": "runCommands", "when": "editorFocus", "args": { "commands": [ "workbench.debug.panel.action.clearReplAction", "workbench.action.focusActiveEditorGroup"]} },
    { "key": "shift+escape",  "command": "workbench.action.focusActiveEditorGroup", "when": "!editorFocus" },
    { "key": "ctrl+l",       "command": "workbench.debug.panel.action.clearReplAction", "when": "panelFocus" },

    // move around panels and terminals
    { "key": "alt+h", "command": "workbench.action.previousPanelView", "when": "panelFocus" },
    { "key": "alt+l", "command": "workbench.action.nextPanelView",     "when": "panelFocus" },
        { "key": "alt+h", "command": "runCommands", "when": "auxiliaryBarFocus", "args": { "commands": ["workbench.action.focusActiveEditorGroup", "workbench.action.previousAuxiliaryBarView", "workbench.action.focusAuxiliaryBar" ]} },
        { "key": "alt+l", "command": "runCommands", "when": "auxiliaryBarFocus", "args": { "commands": ["workbench.action.focusActiveEditorGroup", "workbench.action.nextAuxiliaryBarView", "workbench.action.focusAuxiliaryBar" ]} },


    { "key": "alt+j", "command": "workbench.action.terminal.focusNext", "when": "terminalFocus" },
    { "key": "alt+k", "command": "workbench.action.terminal.focusPrevious", "when": "terminalFocus" },

    //
    // begin: /pc/ahk/keyboard.ahk2 > d::key_modifier_r()
    //
    // @note I forgot why I need to put the <F> remappings here and not in `vim.normalModeKeyBindingsNonRecursive`
    { "key": "f8 f", "command": "vim.remap", "when": "editorTextFocus && vim.mode != 'Insert'", "args": {
        "after": ["<space>", "<space>", "2", "s"]}},
    // clear vscode build in keys
    { "key": "f8", "command": "-editor.action.accessibleDiffViewer.next", "when": "isInDiffEditor" },
    { "key": "f8", "command": "-chatEditor.action.showAccessibleDiffView", "when": "accessibilityModeEnabled && chatEdits.hasEditorModifications && editorFocus && !chatEdits.isCurrentlyBeingModified" },
    { "key": "f7", "command": "-editor.action.wordHighlight.next", "when": "editorTextFocus && hasWordHighlights" },

    //
    // debugger customizations
    //
    { "key": "f9",            "command": "-editor.debug.action.toggleBreakpoint",       "when": "debuggersAvailable && disassemblyViewFocus || debuggersAvailable && editorTextFocus" },
    { "key": "shift+f9",      "command": "-editor.debug.action.toggleInlineBreakpoint", "when": "editorTextFocus" },
    { "key": "shift+f9",      "command": "-settings.action.showContextMenu",            "when": "inSettingsEditor" },
    { "key": "ctrl+k ctrl+i", "command": "-editor.debug.action.showDebugHover",         "when": "editorTextFocus && inDebugMode" },
    // debug interaction tools
    { "key": "f9 c", "command": "editor.debug.action.selectionToRepl" },
    { "key": "f9 s", "command": "editor.debug.action.showDebugHover",         "when": "editorTextFocus && inDebugMode" },
    // watch-related
    { "key": "f9 w", "command": "editor.debug.action.selectionToWatch" },
    { "key": "f9 v", "command": "editor.debug.action.triggerByBreakpoint" },
    // edit
    { "key": "f9 e", "command": "editor.debug.action.editBreakpoint" },
    { "key": "f9 f", "command": "workbench.debug.viewlet.action.addFunctionBreakpointAction" },
    { "key": "f9 g", "command": "editor.debug.action.addLogPoint" },
    { "key": "f9 x", "command": "editor.debug.action.conditionalBreakpoint" },
    // go to
    { "key": "f9 r", "command": "workbench.debug.viewlet.action.reapplyBreakpointsAction" },
    { "key": "f9 t", "command": "editor.debug.action.stepIntoTargets" },
    { "key": "f9 ;", "command": "editor.debug.action.runToCursor" },
    // breakpoint manipulation
    { "key": "f9 h", "command": "editor.debug.action.toggleBreakpoint",       "when": "debuggersAvailable && disassemblyViewFocus || debuggersAvailable && editorTextFocus" },
    { "key": "f9 j", "command": "editor.debug.action.goToPreviousBreakpoint" },
    { "key": "f9 k", "command": "editor.debug.action.goToNextBreakpoint" },
    { "key": "f9 l", "command": "debug.enableOrDisableBreakpoint" },
    { "key": "f9 d", "command": "workbench.debug.viewlet.action.removeAllBreakpoints" },
    { "key": "f9 y", "command": "workbench.debug.viewlet.action.toggleBreakpointsActivatedAction" },
    { "key": "f9 u", "command": "editor.debug.action.toggleInlineBreakpoint", "when": "editorTextFocus" },
    { "key": "f9 i", "command": "editor.debug.action.toggleInlineBreakpoint", "when": "editorTextFocus" }, // @feedabck what to put here?
    { "key": "f9 o", "command": "workbench.debug.action.focusBreakpointsView" },

    //
    // delete lines above and below with single strokes
    // I'm going with vscode's undo redo history instead of vim emulation because it feels better...
    //
    // { "key": "f9 e", "command": "runCommands", "when": "editorTextFocus && !editorHasSelection && vim.mode == 'Normal'", "args": { "commands": [ 
    //     { "command": "vim.remap", "args": { "after": ["_", "-", "d", "d", "<Esc>"] } }, 
    // ] }, },
    // { "key": "f9 r", "command": "runCommands", "when": "editorTextFocus && !editorHasSelection && vim.mode == 'Normal'", "args": { "commands": [ 
    //     { "command": "vim.remap", "args": { "after": ["_", "+", "d", "d", "<Esc>"] } }, 
    // ] }, },
    { "key": "f9 e", "when": "editorTextFocus", "command": "runCommands", "args": { "commands": [ "cursorUp", "editor.action.deleteLines", "cursorUndo" ] } },
    { "key": "f9 r", "when": "editorTextFocus", "command": "runCommands", "args": { "commands": [ "cursorDown", "editor.action.deleteLines", "cursorUndo" ] } },
    // undo redo lines
    // { "key": "f9 x", "command": "runCommands", "when": "editorTextFocus && vim.mode == 'Normal'", "args": { "commands": [ 
    //     { "command": "vim.remap", "args": { "after": ["u"] } }, 
    // ] }, },
    // { "key": "f9 c", "command": "extension.vim_ctrl+r", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "f9 x", "when": "editorTextFocus", "command": "undo" },
    { "key": "f9 c", "when": "editorTextFocus", "command": "redo" },

        // test
        // 1
        // 2
        // 3
        // 4
        // 5
        // 6
        // 7

    //
    // @hack to solve https://github.com/VSCodeVim/Vim/issues/1323
    //
    // i like how multiple cursors behave, and the tradeoff is the vim stack history gets lost...
    { "key": "j", "command": "cursorMove", "args": { "to": "down", "by": "wrappedLine", "value": 1 }, "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "k", "command": "cursorMove", "args": { "to": "up", "by": "wrappedLine", "value": 1 }, "when": "editorTextFocus && vim.mode == 'Normal'" },

    // move around hover toolitp
    // @todo search inside it
    { "key": "h",       "command": "editor.action.scrollLeftHover",  "when": "editorHoverFocused" },
    { "key": "j",       "command": "editor.action.scrollDownHover",  "when": "editorHoverFocused" },
    { "key": "k",       "command": "editor.action.scrollUpHover",    "when": "editorHoverFocused" },
    { "key": "l",       "command": "editor.action.scrollRightHover", "when": "editorHoverFocused" },
    // { "key": "g",     "command": "vim.remap", "when": "vim.active",  "args": { "before": ["g"], "after": ["g"] }  },
    { "key": "g g",     "command": "editor.action.goToTopHover",     "when": "editorHoverFocused" },
    { "key": "shift+g", "command": "editor.action.goToBottomHover",  "when": "editorHoverFocused" },
    { "key": "ctrl+u",  "command": "editor.action.pageUpHover",      "when": "editorHoverFocused" },
    { "key": "ctrl+d",  "command": "editor.action.pageDownHover",    "when": "editorHoverFocused" },
    // { "key": "g h",     "command": "runCommands",                    "when": "editorFocus && vim.mode != 'Insert'", "args": { "commands": [ "editor.action.showDefinitionPreviewHover" ]}},

    // emulate vimium-c smooth scroll
    { "key": "ctrl+e"    , "command": "editorScroll", "when": "editorFocus && vim.active && vim.mode == 'Normal'", "args": {
            "to": "down", "by": "wrappedLine", "value": 5, "revealCursor": false } },
    { "key": "ctrl+y"    , "command": "editorScroll", "when": "editorFocus && vim.active && vim.mode == 'Normal'", "args": {
            "to": "up"  , "by": "line", "value": 3, "revealCursor": false } },
    { "key": "ctrl+space", "command": "cursorMove", "when": "editorFocus && vim.active && vim.mode == 'Normal'", "args": { "to": "viewPortCenter" } },



    //
    // begin: find widget vscode customizations
    //

    // focus on findWidget while preserving it's state
    { "key": "alt+f",  "command": "runCommands", "when": "findWidgetVisible && editorFocus", "args": { "commands": [
        "cursorLineStart", "actions.find", "cursorUndo", ]} },

    { "key": "alt+f", "command": "runCommands", "when": "!findWidgetVisible && editorFocus && editorIsOpen && editor.hasSelection && editorHasSelection", "args": {
        "commands": ["editor.action.startFindReplaceAction", "toggleFindInSelection",
        { "command": "vim.remap", "args": { "after": ["o", "<Esc>"] } }, 
        ] } },

        
    // "restore" original functionality
    { "key": "alt+s", "command": "runCommands", "when": "editorFocus && editorIsOpen", "args": {"commands": [
       "closeFindWidget", "actions.find"
    ]} },
    { "key": "alt+f", "command": "actions.find", "when": "!findWidgetVisible && editorFocus && editorIsOpen && !editor.hasSelection && !editorHasSelection" },
    { "key": "alt+shift+f", "command": "actions.find", "when": "!findWidgetVisible && editorFocus && editorIsOpen && editor.hasSelection && editorHasSelection" },

    // @hack undo & redo editor changes from the findWidget
    { "key": "ctrl+u",        "command": "runCommands", "when": "findWidgetFocused && editorIsOpen", "args": { "commands": [
        "workbench.action.focusActiveEditorGroup",
        "undo",
        "cursorLineStart", "editor.action.startFindReplaceAction", "cursorUndo", ] } },
    { "key": "ctrl+r",  "command": "runCommands", "when": "findWidgetFocused && editorIsOpen", "args": { "commands": [
        "workbench.action.focusActiveEditorGroup",
        "redo",
        "cursorLineStart", "editor.action.startFindReplaceAction", "cursorUndo", ] } },

    // move around from findWidget to Editor
    // { "key": "escape",     "command": "workbench.action.focusActiveEditorGroup", "when": "findWidgetFocused || findInputFocussed" },
    // { "key": "escape",     "command": "runCommands", "when": "findWidgetFocused || findInputFocussed", "args": {"commands": ["workbench.action.focusActiveEditorGroup", "extension.vim_escape", "cursorDown", "cursorUp", "cancelSelection"]} },
    { "key": "shift+escape",     "command": "runCommands", "when": "findWidgetFocused || findInputFocussed", "args": {"commands": ["workbench.action.focusActiveEditorGroup", "extension.vim_escape", "cursorDown", "cursorUp", "cancelSelection"]} },
    // { "key": "shift+escape","command": "closeFindWidget", "when": "findWidgetVisible && editorTextFocus" },
    { "key": "ctrl+enter", "command": "editor.action.replaceAll", "when": "findWidgetFocused && editorIsOpen" },
    { "key": "alt+l",      "command": "toggleFindInSelection", "when": "findWidgetVisible" },
    { "key": "alt+t",      "command": "editor.action.startFindReplaceAction", "when": "findWidgetVisible" },

    // @hack if "editorHasSelection" then nap "n" & "N" to restore selection to jump around
    // now I have two match jump history stacks...
    { "key": "n", "command": "runCommands", "when": "!findWidgetVisible && editorTextFocus && editorHasSelection && vim.mode != 'Insert' && vim.mode != 'CommandlineInProgress' && vim.mode != 'SearchInProgressMode'", "args": { 
        "commands": [ { "command": "vim.remap", "args": { "after": ["g", "v"] } }, 
            "editor.action.moveSelectionToNextFindMatch" ] }, },
    { "key": "shift+n", "command": "runCommands", "when": "!findWidgetVisible && editorTextFocus && editorHasSelection && vim.mode != 'Insert' && vim.mode != 'CommandlineInProgress' && vim.mode != 'SearchInProgressMode'", "args": { 
        "commands": [ { "command": "vim.remap", "args": { "after": ["g", "v"] } }, 
            "editor.action.moveSelectionToPreviousFindMatch" ] },},
    
    { "key": "n", "command": "runCommands", "when": "findWidgetVisible && editorTextFocus && vim.mode != 'Insert' && vim.mode != 'CommandlineInProgress' && vim.mode != 'SearchInProgressMode'", "args": { 
        "commands": ["editor.action.nextMatchFindAction", "cursorDown", "cursorUp", "extension.vim_escape"] }, },
    { "key": "shift+n", "command": "runCommands", "when": "findWidgetVisible && editorTextFocus && vim.mode != 'Insert' && vim.mode != 'CommandlineInProgress' && vim.mode != 'SearchInProgressMode'", "args": { 
        "commands": ["editor.action.previousMatchFindAction", "cursorDown", "cursorUp", "extension.vim_escape"] },},

    { "key": "alt+n", "command": "vim.remap", "when": "editorFocus && vim.mode != 'Insert'", "args": { "after": ["n"] } },
    { "key": "alt+shift+n", "command": "vim.remap", "when": "editorFocus && vim.mode != 'Insert'", "args": { "after": ["N"] } },

    // { "key": "g", "command": "runCommands", "when": "editorTextFocus && vim.mode != 'Insert'", "args": { 
    // "commands": [{ "command": "vim.remap", "args": { "after": ["g"] } }] }, },

    // "preserve" vim's search history...
    // { "key": "g n", "command": "runCommands", "when": "editorTextFocus && vim.mode != 'Insert'", "args": { 
    //     "commands": [{ "command": "vim.remap", "args": { "after": ["n"] } }, "extension.vim_escape"] }, },
    // { "key": "g N", "command": "runCommands", "when": "editorTextFocus && vim.mode != 'Insert'", "args": { 
    //     "commands": [{ "command": "vim.remap", "args": { "after": ["N"] } }, "extension.vim_escape"] }, },
    // { "key": "g n", "command": "vim.remap", "when": "editorTextFocus && vim.mode != 'Insert'", "args": { "after": ["n"] }},
    // { "key": "g N", "command": "vim.remap", "when": "editorTextFocus && vim.mode != 'Insert'", "args": { "after": ["n"] }},

    // alt+n
    // alt+m for selection jump

    // go to previous/next file

    // { "key": "alt+3", "command": "references-view.prev", "when": "inReferenceSearchEditor" },
    // { "key": "alt+8", "command": "references-view.next", "when": "inReferenceSearchEditor" },

    // { "key": "alt+3", "command": "goToPreviousReference", "when": "inReferenceSearchEditor" },
    // { "key": "alt+8", "command": "goToNextReference", "when": "inReferenceSearchEditor" },

    // navigate (F12) `g d` go to definition widget
    { "key": "alt+3", "command": "runCommands", "args": { "commands": [ "workbench.action.focusActiveEditorGroup", "togglePeekWidgetFocus", "list.focusUp", "togglePeekWidgetFocus", ] }, "when": "referenceSearchVisible" },
    { "key": "alt+8", "command": "runCommands", "args": { "commands": [ "workbench.action.focusActiveEditorGroup", "togglePeekWidgetFocus", "list.focusDown", "togglePeekWidgetFocus", ] }, "when": "referenceSearchVisible" },
    { "key": "alt+0", "command": "runCommands", "args": { "commands": [ "workbench.action.focusActiveEditorGroup", "togglePeekWidgetFocus", "list.focusUp", "list.focusDown" ] }, "when": "referenceSearchVisible" },
    // keyboard.ak2 is handling this, it's supposed to be "alt+space" but windows captures it before vscode, to open the window context menu
    { "key": "alt+f7", "command": "runCommands", "args": { "commands": [ "workbench.action.focusActiveEditorGroup", "togglePeekWidgetFocus", "list.select", "extension.vim_insert", "extension.vim_escape" ] }, "when": "referenceSearchVisible" },

    // # & * to move around matches on findWidget
    { "key": "shift+3", "command": "editor.action.previousSelectionMatchFindAction", "when": "editorTextFocus && findWidgetVisible && vim.mode != 'Insert'" },
